<Window x:Class="RoundSoundMimic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RoundSoundMimic"
        mc:Ignorable="d"
        Title="RoundSound Mimic" Height="893" Width="1325" MinWidth="760" MinHeight="520"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        MouseRightButtonUp="Window_OnMouseRightButtonUp"
        PreviewMouseLeftButtonDown="Window_OnPreviewMouseLeftButtonDown"
        Icon="{DynamicResource AppIcon}">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF8A2A" />
        <SolidColorBrush x:Key="ProgressBrush" Color="#FFC166" />
        <SolidColorBrush x:Key="EqSpikeBrush" Color="#C66A18" />
        <SolidColorBrush x:Key="RingBackBrush" Color="#D26E1D" />
        <SolidColorBrush x:Key="PanelBrush" Color="#00FFFFFF" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F2F2F2" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#D8D8D8" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#7A7F8A" />
        <SolidColorBrush x:Key="BandBrush" Color="#B4000000" />
        <SolidColorBrush x:Key="InnerCircleBrush" Color="#9E9E9E" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#D0D0D0" />
        <SolidColorBrush x:Key="ButtonTextBrush" Color="#1F1F1F" />
        <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#CC1F1F1F" />
        <SolidColorBrush x:Key="PopupBorderBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="PopupHoverBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="PopupPressedBrush" Color="#55FFFFFF" />
        <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#EE1A1A1A" />
        <SolidColorBrush x:Key="TooltipBorderBrush" Color="#66FFFFFF" />
        <Pen x:Key="RingBackPen" Brush="{StaticResource RingBackBrush}" Thickness="2" />
        <Geometry x:Key="PrevIcon">M18,4 L18,20 L8,12 Z M6,4 L6,20 L4,20 L4,4 Z</Geometry>
        <Geometry x:Key="PlayIcon">M6,4 L20,12 L6,20 Z</Geometry>
        <Geometry x:Key="PauseIcon">M6,4 L10,4 L10,20 L6,20 Z M14,4 L18,4 L18,20 L14,20 Z</Geometry>
        <Geometry x:Key="NextIcon">M6,4 L6,20 L16,12 Z M18,4 L18,20 L20,20 L20,4 Z</Geometry>
        <Geometry x:Key="VolumeHighIcon">M3,9 L7,9 L12,4 L12,20 L7,15 L3,15 Z M14,8 C16,9 17,11 17,12 C17,13 16,15 14,16 M16,5 C19,7 21,10 21,12 C21,14 19,17 16,19</Geometry>
        <Geometry x:Key="VolumeLowIcon">M3,9 L7,9 L12,4 L12,20 L7,15 L3,15 Z M14,8 C16,9 17,11 17,12 C17,13 16,15 14,16</Geometry>
        <Geometry x:Key="VolumeMuteIcon">M3,9 L7,9 L12,4 L12,20 L7,15 L3,15 Z M14,9 L20,15 M14,15 L20,9</Geometry>
        <DrawingImage x:Key="AppIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{StaticResource ProgressBrush}">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="12,12" RadiusX="6" RadiusY="6" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="Transparent" Pen="{StaticResource RingBackPen}">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="12,12" RadiusX="9" RadiusY="9" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        
        <!-- Converters for lossless indicator -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter" />
        <local:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />
        <local:FormatToBrushConverter x:Key="FormatToBrushConverter" />
        
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="ContentPresenter"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          RenderTransformOrigin="0.5,0.5" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ContentPresenter" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="ContentPresenter" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ContentPresenter" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PopupButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PopupBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PopupBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PopupHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PopupPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PopupTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#22000000" />
            <Setter Property="BorderBrush" Value="{StaticResource PopupBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="RingToolTipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource TooltipBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TooltipBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HasDropShadow" Value="True" />
        </Style>
        <local:VolumeWidthConverter x:Key="VolumeWidthConverter" />
        <local:VolumeToIconConverter x:Key="VolumeToIconConverter" />
        <Storyboard x:Key="AlbumArtRotationStoryboard" RepeatBehavior="Forever" Timeline.DesiredFrameRate="60">
            <DoubleAnimation Storyboard.TargetName="AlbumArtRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0"
                             To="360"
                             Duration="0:0:15" />
            <DoubleAnimation Storyboard.TargetName="VinylGrooveRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0"
                             To="360"
                             Duration="0:0:15" />
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource AlbumArtRotationStoryboard}" />
        </EventTrigger>
    </Window.Triggers>

    <Grid Margin="24" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="24">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas x:Name="DrawingCanvas" Width="640" Height="640" IsHitTestVisible="False">
                    <Ellipse x:Name="RingBackground"
                             Width="600"
                             Height="600"
                             Fill="Transparent"
                             Stroke="{StaticResource RingBackBrush}"
                             StrokeThickness="18"
                             Canvas.Left="20"
                             Canvas.Top="20" />
                    <Ellipse x:Name="ProgressRing"
                             Width="600"
                             Height="600"
                             Fill="Transparent"
                             Stroke="{StaticResource ProgressBrush}"
                             StrokeThickness="18"
                             StrokeStartLineCap="Round"
                             StrokeEndLineCap="Round"
                             StrokeDashArray="{Binding ProgressDashArray}"
                             Canvas.Left="20"
                             Canvas.Top="20"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-90" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Canvas x:Name="EqCanvas"
                            Width="{Binding ActualWidth, ElementName=DrawingCanvas}"
                            Height="{Binding ActualHeight, ElementName=DrawingCanvas}"
                            IsHitTestVisible="False">
                        <Canvas.Effect>
                            <DropShadowEffect x:Name="EqGlowEffect"
                                              BlurRadius="20"
                                              Color="#FF8A2A"
                                              Opacity="0.8"
                                              ShadowDepth="0" />
                        </Canvas.Effect>
                    </Canvas>
                    <Ellipse x:Name="InnerCircle" Width="520" Height="520" Fill="{StaticResource InnerCircleBrush}" Canvas.Left="60" Canvas.Top="60" IsHitTestVisible="False" />
                    <Path x:Name="BandPath" Fill="{StaticResource BandBrush}" />
                    <Grid Canvas.Left="67" Canvas.Top="67" Width="506" Height="506" IsHitTestVisible="False">
                        <!-- Vinyl Record Base -->
                        <Ellipse RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="AlbumArtRotate" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding AlbumArtSource}" Stretch="UniformToFill" Opacity="0.75" />
                            </Ellipse.Fill>
                        </Ellipse>
                        
                        <!-- Vinyl Grooves -->
                        <Ellipse RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="VinylGrooveRotate" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Fill>
                                <RadialGradientBrush GradientOrigin="0.5,0.5">
                                    <GradientStop Offset="0.0" Color="#FF222222" />
                                    <GradientStop Offset="0.1" Color="#FF333333" />
                                    <GradientStop Offset="0.2" Color="#FF222222" />
                                    <GradientStop Offset="0.3" Color="#FF333333" />
                                    <GradientStop Offset="0.4" Color="#FF222222" />
                                    <GradientStop Offset="0.5" Color="#FF333333" />
                                    <GradientStop Offset="0.6" Color="#FF222222" />
                                    <GradientStop Offset="0.7" Color="#FF333333" />
                                    <GradientStop Offset="0.8" Color="#FF222222" />
                                    <GradientStop Offset="0.9" Color="#FF333333" />
                                    <GradientStop Offset="1.0" Color="#FF111111" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.OpacityMask>
                                <RadialGradientBrush GradientOrigin="0.5,0.5">
                                    <GradientStop Offset="0.0" Color="#FF000000" />
                                    <GradientStop Offset="0.95" Color="#00000000" />
                                    <GradientStop Offset="1.0" Color="#FF000000" />
                                </RadialGradientBrush>
                            </Ellipse.OpacityMask>
                        </Ellipse>
                        
                        <!-- Vinyl Center Hole -->
                        <Ellipse Width="32"
                                 Height="32"
                                 Fill="Black"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Grid>
                </Canvas>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                    <TextBlock x:Name="TitleTextBlock"
                               Text="{Binding TitleText}"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ArtistTextBlock"
                               Text="{Binding ArtistText}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="16"
                               Margin="0,6,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="AlbumTextBlock"
                               Text="{Binding AlbumText}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="14"
                               Margin="0,8,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="PlayCountTextBlock"
                               Text="{Binding PlayCountText}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               Margin="0,4,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="FormatTextBlock"
                               Text="{Binding FormatText}"
                               Foreground="{Binding FormatText, Converter={StaticResource FormatToBrushConverter}}"
                               FontSize="12"
                               Margin="0,4,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <StackPanel x:Name="PlaybackControlsPanel" 
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Center" 
                                    VerticalAlignment="Bottom"
                                    Margin="0,10,0,0">
                            <Button x:Name="PrevButton" 
                                    Style="{StaticResource FlatButtonStyle}" 
                                    Width="56" 
                                    Height="38" 
                                    Margin="0,0,8,0" 
                                    Command="{Binding PrevCommand}"
                                    ToolTip="Previous Track">
                                <Viewbox Width="20" Height="20">
                                    <Path Data="{StaticResource PrevIcon}" Fill="White" />
                                </Viewbox>
                            </Button>
                            
                            <Button x:Name="PlayPauseButton" 
                                    Style="{StaticResource FlatButtonStyle}" 
                                    Width="60" 
                                    Height="38" 
                                    Margin="0,0,8,0" 
                                    Command="{Binding PlayPauseCommand}"
                                    ToolTip="Play/Pause">
                                <Button.Content>
                                    <Viewbox Width="20" Height="20">
                                        <Path Fill="White">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Data" Value="{StaticResource PauseIcon}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                            <Setter Property="Data" Value="{StaticResource PlayIcon}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Viewbox>
                                </Button.Content>
                            </Button>
                            
                            <Button x:Name="NextButton" 
                                    Style="{StaticResource FlatButtonStyle}" 
                                    Width="56" 
                                    Height="38" 
                                    Command="{Binding NextCommand}"
                                    ToolTip="Next Track">
                                <Viewbox Width="20" Height="20">
                                    <Path Data="{StaticResource NextIcon}" Fill="White" />
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    <StackPanel x:Name="VolumePanel" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Bottom"
                                Margin="0,8,0,0">
                        <Button x:Name="VolumeButton" 
                                Style="{StaticResource FlatButtonStyle}" 
                                Width="36" 
                                Height="28" 
                                Margin="0,0,4,0"
                                Command="{Binding MuteCommand}"
                                ToolTip="{Binding VolumeToolTip}">
                            <Viewbox Width="16" Height="16">
                                <Path Fill="White" Data="{Binding Volume, Converter={StaticResource VolumeToIconConverter}}" />
                            </Viewbox>
                        </Button>
                        <Slider x:Name="VolumeSlider"
                                Width="100"
                                Height="28"
                                Minimum="0"
                                Maximum="100"
                                SmallChange="1"
                                LargeChange="10"
                                IsSnapToTickEnabled="True"
                                TickFrequency="1"
                                Value="{Binding Volume, Mode=TwoWay}"
                                ToolTip="{Binding VolumeToolTip}"
                                Margin="0,0,8,0">
                            <Slider.Style>
                                <Style TargetType="Slider">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Slider">
                                                <Grid>
                                                    <Border x:Name="TrackBackground"
                                                            Height="4"
                                                            Width="100"
                                                            Background="#33FFFFFF"
                                                            CornerRadius="2"
                                                            VerticalAlignment="Center" />
                                                    <Border x:Name="TrackFill"
                                                            Height="4"
                                                            Background="{StaticResource ProgressBrush}"
                                                            CornerRadius="2"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Left">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource VolumeWidthConverter}">
                                                                <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                                                <Binding Path="ActualWidth" ElementName="TrackBackground" />
                                                            </MultiBinding>
                                                        </Border.Width>
                                                    </Border>
                                                    <Track x:Name="PART_Track">
                                                        <Track.Thumb>
                                                            <Thumb Width="12" Height="12" Cursor="Hand">
                                                                <Thumb.Style>
                                                                    <Style TargetType="Thumb">
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="Thumb">
                                                                                    <Border Background="{StaticResource AccentBrush}"
                                                                                            BorderBrush="#FFFFFFFF"
                                                                                            BorderThickness="1"
                                                                                            CornerRadius="6">
                                                                                        <Border.Effect>
                                                                                            <DropShadowEffect BlurRadius="8"
                                                                                                              Color="#FF8A2A"
                                                                                                              Opacity="0.8"
                                                                                                              ShadowDepth="0" />
                                                                                        </Border.Effect>
                                                                                    </Border>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Style>
                                                                </Thumb.Style>
                                                            </Thumb>
                                                        </Track.Thumb>
                                                    </Track>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Slider.Style>
                        </Slider>
                        <TextBlock Text="{Binding Volume, StringFormat={}{0}%}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Width="32"
                                   TextAlignment="Right" />
                    </StackPanel>
                    </StackPanel>
                </Grid>
        </Border>

        <Popup x:Name="MenuPopup"
               Placement="MousePoint"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="{StaticResource PopupBackgroundBrush}" BorderBrush="{StaticResource PopupBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.35" />
                </Border.Effect>
                <StackPanel>
                    <Button x:Name="OpenConfigButton" Style="{StaticResource PopupButtonStyle}" Width="160" Margin="0,0,0,8" Click="OpenConfigButton_OnClick">Open Config</Button>
                    <Button x:Name="MinimizeButton" Style="{StaticResource PopupButtonStyle}" Width="160" Margin="0,0,0,8" Click="MinimizeButton_OnClick">Minimize</Button>
                    <Button x:Name="ExitButton" Style="{StaticResource PopupButtonStyle}" Width="160" Click="ExitButton_OnClick">Exit</Button>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="ConfigPopup"
               Placement="MousePoint"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="{StaticResource PopupBackgroundBrush}" BorderBrush="{StaticResource PopupBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.35" />
                </Border.Effect>
                <StackPanel>
                    <Button x:Name="FetchButton" Style="{StaticResource PopupButtonStyle}" Width="160" Margin="0,0,0,12" Command="{Binding FetchCommand}">Fetch Now Playing</Button>
                    <TextBlock x:Name="StatusTextBlock"
                               Margin="0,0,0,12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding StatusText}" />
                    <TextBlock Text="Jellyfin Server" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBox x:Name="ServerUrlTextBox"
                             Margin="0,6,0,12"
                             Height="28"
                             VerticalContentAlignment="Center"
                             Style="{StaticResource PopupTextBoxStyle}"
                             Text="{Binding ServerUrlText, Mode=TwoWay}"
                             ToolTip="https://your-server:8096" />

                    <TextBlock Text="API Key" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBox x:Name="ApiKeyTextBox"
                             Margin="0,6,0,12"
                             Height="28"
                             VerticalContentAlignment="Center"
                             Style="{StaticResource PopupTextBoxStyle}"
                             Text="{Binding ApiKeyText, Mode=TwoWay}" />

                    <TextBlock Text="User Id (optional)" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBox x:Name="UserIdTextBox"
                             Margin="0,6,0,12"
                             Height="28"
                             VerticalContentAlignment="Center"
                             Style="{StaticResource PopupTextBoxStyle}"
                             Text="{Binding UserIdText, Mode=TwoWay}" />

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SaveButton"
                                Style="{StaticResource PopupButtonStyle}"
                                Width="110"
                                Margin="0,0,8,0"
                                Command="{Binding SaveConfigCommand}">Save Config</Button>
                        <Button x:Name="CloseButton"
                                Style="{StaticResource PopupButtonStyle}"
                                Width="70"
                                Click="CloseButton_OnClick">Close</Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
