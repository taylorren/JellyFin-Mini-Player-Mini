<Window x:Class="RoundSoundMimic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RoundSoundMimic"
        mc:Ignorable="d"
        Title="RoundSound Mimic" Height="893" Width="1325" MinWidth="760" MinHeight="520"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        MouseRightButtonUp="Window_OnMouseRightButtonUp"
        PreviewMouseLeftButtonDown="Window_OnPreviewMouseLeftButtonDown"
        Icon="{DynamicResource AppIcon}">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF8A2A" />
        <SolidColorBrush x:Key="ProgressBrush" Color="#FFC166" />
        <SolidColorBrush x:Key="EqSpikeBrush" Color="#C66A18" />
        <SolidColorBrush x:Key="RingBackBrush" Color="#D26E1D" />
        <SolidColorBrush x:Key="PanelBrush" Color="#00FFFFFF" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F2F2F2" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#D8D8D8" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#7A7F8A" />
        <SolidColorBrush x:Key="BandBrush" Color="#B4000000" />
        <SolidColorBrush x:Key="InnerCircleBrush" Color="#9E9E9E" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#D0D0D0" />
        <SolidColorBrush x:Key="ButtonTextBrush" Color="#1F1F1F" />
        <Pen x:Key="RingBackPen" Brush="{StaticResource RingBackBrush}" Thickness="2" />
        <Geometry x:Key="PrevIcon">M18,4 L18,20 L8,12 Z M6,4 L6,20 L4,20 L4,4 Z</Geometry>
        <Geometry x:Key="PlayIcon">M6,4 L20,12 L6,20 Z</Geometry>
        <Geometry x:Key="PauseIcon">M6,4 L10,4 L10,20 L6,20 Z M14,4 L18,4 L18,20 L14,20 Z</Geometry>
        <Geometry x:Key="NextIcon">M6,4 L6,20 L16,12 Z M18,4 L18,20 L20,20 L20,4 Z</Geometry>
        <DrawingImage x:Key="AppIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{StaticResource ProgressBrush}">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="12,12" RadiusX="6" RadiusY="6" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="Transparent" Pen="{StaticResource RingBackPen}">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="12,12" RadiusX="9" RadiusY="9" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="ContentPresenter"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          RenderTransformOrigin="0.5,0.5" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ContentPresenter" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="ContentPresenter" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ContentPresenter" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Storyboard x:Key="AlbumArtRotationStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="AlbumArtRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0"
                             To="360"
                             Duration="0:0:20" />
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource AlbumArtRotationStoryboard}" />
        </EventTrigger>
    </Window.Triggers>

    <Grid Margin="24" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="24">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas x:Name="DrawingCanvas" Width="640" Height="640">
                    <Ellipse Width="600" Height="600" Stroke="{StaticResource RingBackBrush}" StrokeThickness="18" Canvas.Left="20" Canvas.Top="20" />
                    <Ellipse x:Name="ProgressRing"
                             Width="600"
                             Height="600"
                             Stroke="{StaticResource ProgressBrush}"
                             StrokeThickness="18"
                             StrokeStartLineCap="Round"
                             StrokeEndLineCap="Round"
                             Canvas.Left="20"
                             Canvas.Top="20"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-90" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Canvas x:Name="EqCanvas"
                            Width="{Binding ActualWidth, ElementName=DrawingCanvas}"
                            Height="{Binding ActualHeight, ElementName=DrawingCanvas}"
                            IsHitTestVisible="False" />
                    <Ellipse x:Name="InnerCircle" Width="520" Height="520" Fill="{StaticResource InnerCircleBrush}" Canvas.Left="60" Canvas.Top="60" />
                    <Path x:Name="BandPath" Fill="{StaticResource BandBrush}" />
                    <Grid Canvas.Left="67" Canvas.Top="67" Width="506" Height="506">
                        <Ellipse RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="AlbumArtRotate" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Fill>
                                <ImageBrush x:Name="AlbumArtBrush" Stretch="UniformToFill" Opacity="0.75" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Fill="#22000000" RenderTransformOrigin="0.5,0.5" >
                            <Ellipse.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform AngleY="-0.846"/>
                                    <RotateTransform/>
                                    <TranslateTransform Y="-3.735"/>
                                </TransformGroup>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                </Canvas>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                    <TextBlock x:Name="TitleTextBlock"
                               Text="(no data)"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ArtistTextBlock"
                               Text=""
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="16"
                               Margin="0,6,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="AlbumTextBlock"
                               Text=""
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="14"
                               Margin="0,8,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button x:Name="PrevButton" Style="{StaticResource FlatButtonStyle}" Width="56" Height="38" Margin="0,0,8,0" Click="PrevButton_OnClick">
                            <Viewbox Width="20" Height="20">
                                <Path Data="{StaticResource PrevIcon}" Fill="White" />
                            </Viewbox>
                        </Button>
                        <Button x:Name="PlayPauseButton" Style="{StaticResource FlatButtonStyle}" Width="60" Height="38" Margin="0,0,8,0" Click="PlayPauseButton_OnClick" />
                        <Button x:Name="NextButton" Style="{StaticResource FlatButtonStyle}" Width="56" Height="38" Click="NextButton_OnClick">
                            <Viewbox Width="20" Height="20">
                                <Path Data="{StaticResource NextIcon}" Fill="White" />
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Popup x:Name="ConfigPopup"
               Placement="MousePoint"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16">
                <StackPanel>
                    <Button x:Name="FetchButton" Width="160" Height="32" Margin="0,0,0,12" Click="FetchButton_OnClick">Fetch Now Playing</Button>
                    <TextBlock x:Name="StatusTextBlock"
                               Margin="0,0,0,12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Idle" />
                    <TextBlock Text="Jellyfin Server" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBox x:Name="ServerUrlTextBox"
                             Margin="0,6,0,12"
                             Height="28"
                             VerticalContentAlignment="Center"
                             ToolTip="https://your-server:8096" />

                    <TextBlock Text="API Key" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBox x:Name="ApiKeyTextBox"
                             Margin="0,6,0,12"
                             Height="28"
                             VerticalContentAlignment="Center" />

                    <TextBlock Text="User Id (optional)" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBox x:Name="UserIdTextBox"
                             Margin="0,6,0,12"
                             Height="28"
                             VerticalContentAlignment="Center" />

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SaveButton"
                                Width="110"
                                Height="30"
                                Margin="0,0,8,0"
                                Click="SaveButton_OnClick">Save Config</Button>
                        <Button x:Name="CloseButton"
                                Width="70"
                                Height="30"
                                Click="CloseButton_OnClick">Close</Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
